// 2026-10-26 删除 i2s_bck(U21) / i2s_ws(T18) / i2s_din(P17)：
//   独立 I2S DAC 输出本工程不使用，三个脚已分别改作 tlc_lat / enc_a / 空闲。

// ===========================================================================
// 2026-10-22 新增：蓝牙 BLE 模块 EWT104-BT52（115200 8N1 透传）
//   脚位来源：SiPEED 官方 pmod_led 例程的 "PMOD near the hdmi connector" 组，
//   这一组与上侧 40P 排针复用。该组 8 个脚里 Y21/Y22/AA20/AA21/AB21/AB22 已给
//   MPR121×2 与 VL53L0X，只剩 AA19 / AB20 两个空位 ⇒ 正好给 TXD/RXD。
//   修改批注：LINK未接，QUERY只反映近期有效流量，不是BLE连接状态证明。
//   rxd 开内部上拉：模块没插时线路保持空闲高，不会因悬空产生假起始位。
// ===========================================================================
IO_LOC "bt_rxd" AA19;
IO_PORT "bt_rxd" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "bt_txd" AB20;
IO_PORT "bt_txd" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
