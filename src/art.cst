// 2026-10-20 审查修改：保留原键盘引脚；CPU/MSPI作为普通IO选项需保留。
IO_LOC  "clk"  V22;
IO_PORT "clk"  IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "rst_n"  AA13;
IO_PORT "rst_n"  IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
IO_LOC  "key1"  AB13;
IO_PORT "key1"  IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
IO_LOC  "hp_bck"  Y17;
IO_PORT "hp_bck"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "hp_ws"   AB17;
IO_PORT "hp_ws"   IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "hp_din"  AA16;
IO_PORT "hp_din"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "pa_en"   AB16;
IO_PORT "pa_en"   IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// 2026-10-26 引脚重排（按实物接线，三路 I2C 两两成对）：
//   I2C-1 MPR121#1 → AB21/AB22、I2C-2 MPR121#2 → Y21/Y22、I2C-3 VL53L0X → AA20/AA21。
//   i2s_bck/ws/din 三脚已取消（独立 I2S DAC 输出不使用），原 U21/T18/P17 回收再利用。
IO_LOC  "mpr_scl"  AB21;
IO_PORT "mpr_scl"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "mpr_sda"  AB22;
IO_PORT "mpr_sda"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "vl53_scl"  AA20;
IO_PORT "vl53_scl"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "vl53_sda"  AA21;
IO_PORT "vl53_sda"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "uart_txd"  U15;
IO_PORT "uart_txd"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "mpr2_scl"  Y21;
IO_PORT "mpr2_scl"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "mpr2_sda"  Y22;
IO_PORT "mpr2_sda"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// 2026-10-26 LED 驱动链路重排，新增 tlc_bla（BLANK 全局消隐，高=全灭）。
//   位置调整：tlc_clk 落在 R17、tlc_sin 落在 R19（两者相邻，SCLK 与数据走线等长并排）。
//   注意：TLC59282 的锁存是 LAT（SSOP-24 pin4 / QFN-24 pin1）；
//   BLANK 是 pin21 / pin18，只做全灭与调光。两者不可再短接。
//   R19 原为 enc_b，编码器已挪到 P16，实物必须把 R19 从编码器 B 相断开。
IO_LOC  "tlc_clk"  R17;
IO_PORT "tlc_clk"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "tlc_sin"  R19;
IO_PORT "tlc_sin"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "tlc_lat"  U21;
IO_PORT "tlc_lat"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "tlc_bla"  P19;
IO_PORT "tlc_bla"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "enc_a"  T18;
IO_PORT "enc_a"  IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "enc_b"  P16;
IO_PORT "enc_b"  IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "enc_sw"  R18;
IO_PORT "enc_sw"  IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// 新增：底板31004 Rev1.4 第6/12页，RGB666连接J5的R2..7/G2..7/B2..7。
